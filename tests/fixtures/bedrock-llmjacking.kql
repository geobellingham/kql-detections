// Test fixture: bedrock-llmjacking
// EXPECT: exactly 1 row
//   UserIdentityArn = arn:aws:iam::123456789012:user/ci-deploy, AlertSeverity = High, Score = 13
//   Reasons: Model access enabled | Checked whether prompt logging is on | Invoke probes failing across models |
//            Identity never used Bedrock in 13d | New source IP | 3+ different models | 3+ regions | Long-term IAM user key
// MUST NOT appear:
//   - approved app role arn:aws:iam::111111111111:role/genai-app-prod (heavy but allow-listed)
//   - developer alice, who already used Bedrock from the same IP 2 days ago
let AWSCloudTrail = datatable(
    Offset: timespan, EventSource: string, EventName: string, UserIdentityArn: string, UserIdentityType: string,
    UserIdentityAccessKeyId: string, SourceIpAddress: string, AWSRegion: string, RecipientAccountId: string,
    ErrorCode: string, RequestParameters: string, UserAgent: string)
[
    // --- attacker: stolen CI key, known only from S3 use until now ---
    -3d,  "s3.amazonaws.com",      "ListBuckets",                            "arn:aws:iam::123456789012:user/ci-deploy", "IAMUser", "AKIAEXAMPLECI", "198.51.100.10", "eu-west-1",    "123456789012", "",                      "{}",                                         "aws-cli/2.15",
    -40m, "bedrock.amazonaws.com", "ListFoundationModels",                   "arn:aws:iam::123456789012:user/ci-deploy", "IAMUser", "AKIAEXAMPLECI", "203.0.113.66",  "us-east-1",    "123456789012", "",                      "{}",                                         "python-requests/2.31",
    -39m, "bedrock.amazonaws.com", "GetModelInvocationLoggingConfiguration", "arn:aws:iam::123456789012:user/ci-deploy", "IAMUser", "AKIAEXAMPLECI", "203.0.113.66",  "us-east-1",    "123456789012", "",                      "{}",                                         "python-requests/2.31",
    -38m, "bedrock.amazonaws.com", "GetFoundationModelAvailability",         "arn:aws:iam::123456789012:user/ci-deploy", "IAMUser", "AKIAEXAMPLECI", "203.0.113.66",  "us-east-1",    "123456789012", "",                      "{}",                                         "python-requests/2.31",
    -37m, "bedrock.amazonaws.com", "InvokeModel",                            "arn:aws:iam::123456789012:user/ci-deploy", "IAMUser", "AKIAEXAMPLECI", "203.0.113.66",  "us-east-1",    "123456789012", "ValidationException",   '{"modelId":"anthropic.claude-3-sonnet"}',    "python-requests/2.31",
    -36m, "bedrock.amazonaws.com", "InvokeModel",                            "arn:aws:iam::123456789012:user/ci-deploy", "IAMUser", "AKIAEXAMPLECI", "203.0.113.66",  "us-west-2",    "123456789012", "AccessDeniedException", '{"modelId":"meta.llama3-70b-instruct-v1:0"}', "python-requests/2.31",
    -30m, "bedrock.amazonaws.com", "PutUseCaseForModelAccess",               "arn:aws:iam::123456789012:user/ci-deploy", "IAMUser", "AKIAEXAMPLECI", "203.0.113.66",  "eu-central-1", "123456789012", "",                      "{}",                                         "python-requests/2.31",
    -20m, "bedrock.amazonaws.com", "Converse",                               "arn:aws:iam::123456789012:user/ci-deploy", "IAMUser", "AKIAEXAMPLECI", "203.0.113.66",  "us-west-2",    "123456789012", "",                      '{"modelId":"anthropic.claude-v2"}',          "python-requests/2.31",
    // --- approved application role: ignored ---
    -25m, "bedrock.amazonaws.com", "ListFoundationModels",                   "arn:aws:iam::111111111111:role/genai-app-prod", "AssumedRole", "ASIAEXAMPLEAPP", "52.94.1.1", "us-east-1", "111111111111", "", "{}", "Boto3/1.34",
    -24m, "bedrock.amazonaws.com", "InvokeModel",                            "arn:aws:iam::111111111111:role/genai-app-prod", "AssumedRole", "ASIAEXAMPLEAPP", "52.94.1.1", "us-east-1", "111111111111", "ValidationException", '{"modelId":"x.y"}', "Boto3/1.34",
    // --- developer with an existing Bedrock habit, same IP: no alert ---
    -2d,  "bedrock.amazonaws.com", "InvokeModel",                            "arn:aws:sts::123456789012:assumed-role/dev/alice", "AssumedRole", "ASIAEXAMPLEDEV", "198.51.100.20", "eu-west-1", "123456789012", "", '{"modelId":"anthropic.claude-3-haiku"}', "aws-sdk-js/3",
    -15m, "bedrock.amazonaws.com", "InvokeModel",                            "arn:aws:sts::123456789012:assumed-role/dev/alice", "AssumedRole", "ASIAEXAMPLEDEV", "198.51.100.20", "eu-west-1", "123456789012", "", '{"modelId":"anthropic.claude-3-haiku"}', "aws-sdk-js/3",
    -10m, "bedrock.amazonaws.com", "Converse",                               "arn:aws:sts::123456789012:assumed-role/dev/alice", "AssumedRole", "ASIAEXAMPLEDEV", "198.51.100.20", "eu-west-1", "123456789012", "", '{"modelId":"anthropic.claude-3-haiku"}', "aws-sdk-js/3"
